# Copy to .env and fill in for your machine. EXPO_PUBLIC_ vars are inlined
# at build time (same mechanism as Next.js's NEXT_PUBLIC_*) — see
# src/constants/config.ts.
#
# A physical phone/tablet cannot reach 127.0.0.1 or localhost — that
# resolves to the device itself, not your dev machine. Use your machine's
# LAN IP instead (ipconfig on Windows, ifconfig/ip addr on macOS/Linux),
# and make sure the phone is on the same Wi-Fi network as the API.
# An emulator/simulator or `expo start --web` can use localhost directly.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
