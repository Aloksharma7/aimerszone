APP_NAME="Institution LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en

# The Next.js origin. Used for CORS, Sanctum stateful domains and mail links.
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nepal_lms
# Use a dedicated app user, not root — on Ubuntu/Debian, root@localhost uses
# the auth_socket plugin and will always reject password/TCP logins, which
# reads as "Access denied" no matter what password is set here.
DB_USERNAME=nepal_lms_app
DB_PASSWORD=

# Session driver MUST stay "database": the account security screen lists and revokes sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=lms_session

# Must include the origin the browser is on. Signed media links are built
# against the forwarded host, so this and FRONTEND_URL must agree.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The Next.js server is the only thing allowed to reach this API. Set to a
# comma-separated list instead of * if the API is also exposed directly.
TRUSTED_PROXIES=*

# Signed media links (live join, recordings, resources, payment proof)
LMS_SIGNED_URL_TTL=300
LMS_PROOF_MAX_KB=5120
LMS_PROOF_MIMES=jpg,jpeg,png,webp,pdf

# Zoom Server-to-Server OAuth (Zoom Marketplace > Build App > Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=
ZOOM_BASE_URL=https://api.zoom.us/v2
ZOOM_OAUTH_URL=https://zoom.us/oauth/token
ZOOM_DOWNLOAD_TIMEOUT=1800

# A separate Zoom app: Marketplace > Build App > Webhook-only (or a General
# App's Event Subscription), subscribed to "recording.completed", pointed at
# https://<your-api-domain>/api/v1/webhooks/zoom. This secret comes from
# that app's Feature > Access page, not the Server-to-Server app above.
ZOOM_WEBHOOK_SECRET_TOKEN=

# YouTube Data API v3 (OAuth refresh token for an account owning the channel)
# Must include the youtube.upload scope — a refresh token created only for
# reading video metadata will fail every upload with an insufficient-scope
# error.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_OAUTH_URL=https://oauth2.googleapis.com/token
YOUTUBE_UPLOAD_TIMEOUT=3600
