NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Your Institution LMS"
NEXT_PUBLIC_APP_SHORT_NAME="YI"
NEXT_PUBLIC_APP_TAGLINE="Live classes, recordings, tests and support in one clear place."
NEXT_PUBLIC_APP_URL="https://lms.example.com"
NEXT_PUBLIC_SUPPORT_PHONE="+977 98XXXXXXXX"
NEXT_PUBLIC_WHATSAPP_NUMBER="97798XXXXXXXX"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_ADDRESS="Kathmandu, Nepal"
NEXT_PUBLIC_MAP_URL="https://www.google.com/maps/search/?api=1&query=Kathmandu%2C%20Nepal"
NEXT_PUBLIC_SUPPORT_HOURS="Sunday to Friday, 9:00 AM–6:00 PM (Nepal time)."

# Recommended: same-origin browser requests through Next.js rewrites.
NEXT_PUBLIC_API_BASE_URL=""
API_INTERNAL_URL="http://laravel-api:8000"
SESSION_COOKIE_NAME="your_laravel_session_cookie_name"
NEXT_PUBLIC_ALLOWED_EXTERNAL_HOSTS="zoom.us,youtube.com,youtu.be,youtube-nocookie.com,storage.example.com"

NEXT_PUBLIC_USE_MOCK_DATA="false"
ALLOW_MOCK_DATA_IN_PRODUCTION="false"
