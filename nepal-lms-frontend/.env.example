# Public institution identity
NEXT_PUBLIC_APP_NAME="Institution LMS"
NEXT_PUBLIC_APP_SHORT_NAME="IL"
NEXT_PUBLIC_APP_TAGLINE="Live classes, recordings, tests and support in one clear place."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE="+977 9800000000"
NEXT_PUBLIC_WHATSAPP_NUMBER="9779800000000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.test"
NEXT_PUBLIC_ADDRESS="Kathmandu, Nepal"
NEXT_PUBLIC_MAP_URL="https://www.google.com/maps/search/?api=1&query=Kathmandu%2C%20Nepal"
NEXT_PUBLIC_SUPPORT_HOURS="Sunday to Friday, 9:00 AM–6:00 PM (Nepal time)."

# Laravel API. Keep the browser base empty to use the included same-origin rewrites.
NEXT_PUBLIC_API_BASE_URL=""
API_INTERNAL_URL="http://127.0.0.1:8000"
# MUST equal SESSION_COOKIE in the Laravel .env, or every protected page
# redirects to /login forever.
SESSION_COOKIE_NAME="lms_session"

# Comma-separated parent domains allowed for authorized redirects/downloads.
# Add the exact storage/CDN parent domain used by Laravel signed URLs.
NEXT_PUBLIC_ALLOWED_EXTERNAL_HOSTS="zoom.us,youtube.com,youtu.be,youtube-nocookie.com"

# HTTPS origins allowed as a <form action> target (payment gateway redirects).
NEXT_PUBLIC_PAYMENT_FORM_ORIGINS="https://esewa.com.np,https://epay.esewa.com.np,https://rc-epay.esewa.com.np,https://rc.esewa.com.np"

# Local design preview only. Set to "true" only to browse the UI without a
# running API; the real data path is exercised with "false".
NEXT_PUBLIC_USE_MOCK_DATA="false"
ALLOW_MOCK_DATA_IN_PRODUCTION="false"
